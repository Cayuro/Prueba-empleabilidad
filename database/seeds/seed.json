{
  "entities": [
    "rw_users",
    "rw_channels",
    "rw_channel_members",
    "rw_messages",
    "rw_message_reads",
    "rw_embeddings",
    "rw_refresh_tokens",
    "rw_copilot_usage"
  ],
  "relationships": [
    "rw_users 1:N rw_channels (via rw_created_by)",
    "rw_users 1:N rw_channel_members (via rw_user_id)",
    "rw_channels 1:N rw_channel_members (via rw_channel_id)",
    "rw_channels 1:N rw_messages (via rw_channel_id)",
    "rw_users 1:N rw_messages (via rw_author_id)",
    "rw_messages 1:1 rw_embeddings (via rw_message_id)",
    "rw_messages 1:N rw_message_reads (via rw_message_id)",
    "rw_users 1:N rw_message_reads (via rw_user_id)",
    "rw_users 1:N rw_refresh_tokens (via rw_user_id)",
    "rw_users 1:N rw_copilot_usage (via rw_user_id)"
  ],
  "business_rules": [
    "No physical deletions: all deletes are logical via rw_deleted_at = NOW() and rw_is_active = FALSE (D-01, D-02)",
    "Foreign keys strictly use ON DELETE RESTRICT on all relations (D-01)",
    "Public channels are open to all active platform users; private channels are restricted strictly to channel members (D-12, D-13)",
    "Messages can only be posted by members of the target channel",
    "Row Level Security (RLS) acts as the single source of truth for row access authorization (D-12)",
    "Keyset pagination on messages using cursor (rw_created_at, rw_id) without OFFSET (D-06)",
    "Database privileges for rw_app exclude DELETE on all tables (D-09)",
    "Full-text search vector rw_tsv is automatically maintained by PostgreSQL trigger (D-10)"
  ],
  "normalization_notes": {
    "1FN": "All attributes contain atomic values, multi-valued attributes separated into junction tables (rw_channel_members, rw_message_reads), primary keys defined on all entities.",
    "2FN": "All non-key columns are fully functionally dependent on the entire composite primary key in junction entities.",
    "3FN": "No transitive functional dependencies exist. User attributes, channel metadata, token stores, and copilot usage are decoupled into dedicated normalized relations."
  },
