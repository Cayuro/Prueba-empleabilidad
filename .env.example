# =============================================================================
# Riwi Internal Messaging Platform with AI — Environment Variables Example
# =============================================================================

# Database Configuration (PostgreSQL 15+ with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_juan_gomez_hamilton
DB_USER=postgres
DB_PASSWORD=postgres
DB_APP_USER=rw_app
DB_APP_PASSWORD=rw_app_secure_pwd_2026!

# Backend Database URL
DATABASE_URL=postgres://rw_app:rw_app_secure_pwd_2026!@db:5432/bd_juan_gomez_hamilton

# JWT Configuration (D-07, D-08)
JWT_SECRET=changeme_min_32_characters_secret_key_riwi_2026
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# AI Provider Configuration (Google Gemini)
# Options: 'gemini', 'mock'
AI_PROVIDER=gemini

# Google Gemini API Key (Obtén tu API key gratuita en: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Embedding Provider Configuration
# Options: 'mock'
EMBEDDING_PROVIDER=mock

# System Prompt Version
SYSTEM_PROMPT_VERSION=1

# WebSocket STOMP Endpoint
WEBSOCKET_ENDPOINT=/ws

# Service Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
